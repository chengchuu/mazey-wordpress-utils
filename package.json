{
  "name": "mazey-wordpress-utils",
  "version": "1.4.2",
  "description": "WordPress Utilities",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "typings": "lib/index.d.ts",
  "mainEntryPointFilePath": "lib/index.d.ts",
  "jest": {
    "testPathIgnorePatterns": [
      "/dist/",
      "/lib/"
    ]
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "rollup -c",
    "test": "jest --runInBand",
    "release": "npm run build && npm publish",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "check-health": "npm run lint && npm run build && npm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/mazey-wordpress-utils.git"
  },
  "keywords": [
    "WordPress",
    "Utilities",
    "Utils",
    "LazyLoad",
    "Lazy",
    "Loading",
    "JavaScript",
    "Function"
  ],
  "author": "Cheng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chengchuu/mazey-wordpress-utils/issues"
  },
  "homepage": "https://github.com/chengchuu/mazey-wordpress-utils#readme",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "8.57.1",
    "html-webpack-plugin": "5.6.7",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.5.2",
    "rollup": "4.62.2",
    "rollup-plugin-typescript2": "0.37.0",
    "ts-loader": "9.6.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "webpack": "5.108.4",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "copy-to-clipboard": "3.3.3",
    "core-js": "^3.49.0",
    "mazey": "^5.6.0"
  }
