{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/index.ts", "./typing.d.ts"],
  "exclude": [
    "./coverage",
    "./dist-dev",
    "./docs",
    "./lib",
    "./node_modules"
  ]
}
